{
  "name": "ts-starter",
  "type": "module",
  "version": "0.0.0",
  "description": "My awesome typescript library",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/sxzz/ts-starter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sxzz/ts-starter.git"
  },
  "bugs": {
    "url": "https://github.com/sxzz/ts-starter/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.5.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "vite build",
    "dev": "vite",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "vue": "^3.5.43",
    "vue-json-pretty": "^2.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.4",
    "@types/node": "^26.5.1",
    "@typescript/native-preview": "npm:typescript@~7.0.2",
    "bumpp": "^12.3.0",
    "eslint": "^10.10.0",
    "eslint-factory": "^0.1.2",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "tsdown-preset-sxzz": "^0.7.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.0"
  }
}
